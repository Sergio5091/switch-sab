generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
}

enum LicenceStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Salle {
  id           Int       @id @default(autoincrement())
  nom          String
  proprietaire String
  telephone    String
  pays         String
  ville        String
  quartier     String
  machineId    String    @unique
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  licences Licence[]
}

model Licence {
  id         Int           @id @default(autoincrement())
  licenceId  String        @unique
  salleId    Int
  machineId  String
  issuedAt   DateTime      @default(now())
  expiresAt  DateTime
  status     LicenceStatus @default(ACTIVE)
  signature  String
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())

  salle Salle @relation(fields: [salleId], references: [id])
}

model User {
  id         Int      @id @default(autoincrement())
  pseudo     String   @unique
  email      String   @unique
  telephone  String?  @unique
  motDePasse String
  role       Role     @default(SUPERADMIN)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}
